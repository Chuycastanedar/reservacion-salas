# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env

# --- Django ---
# Genera una clave propia, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# POSTGRES_HOST debe coincidir con el nombre del servicio en compose.yaml
POSTGRES_DB=reservacion_salas
POSTGRES_USER=reservaciones
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_HOST=db
POSTGRES_PORT=5432
